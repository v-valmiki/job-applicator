# Copy to .env (gitignored). Environment variables override these.
# Webhook for pings (required). Server Settings > Integrations > Webhooks.
DISCORD_WEBHOOK_URL=
# Your Discord user ID (optional; makes pings actually notify you).
DISCORD_USER_ID=
# Bot token + channel ID (optional; together they enable reading your replies).
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# Optional default password for job-portal accounts (only used if profile password_handling = env_default).
# Reusing one password across portals is risky; prefer your browser's password manager.
JOB_PORTAL_PASSWORD=
