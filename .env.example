# Copy to .env (gitignored). Environment variables override these.
# Webhook for pings (required). Server Settings > Integrations > Webhooks.
DISCORD_WEBHOOK_URL=
# Your Discord user ID (optional; makes pings actually notify you).
DISCORD_USER_ID=
# Bot token + channel ID (optional; together they enable reading your replies).
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
